# --- Required ---
# Your own Anthropic API key (get one at https://console.anthropic.com)
# This is YOUR account, separate from your personal Claude.ai subscription.
# You are billed per API call - with Haiku this runs a few cents per 100 conversations.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- Required for email lead notifications ---
# RECOMMENDED: Resend (resend.com) - free tier, doesn't depend on your real
# mailbox provider, and avoids Microsoft's SMTP AUTH deprecation entirely.
#   1. Sign up, add a domain - use a SUBDOMAIN like leads.yourdomain.com, not
#      your bare domain. This keeps it completely separate from your real
#      mailbox's existing SPF/MX records (mixing them can break real mail).
#   2. Add the SPF/DKIM records Resend shows you, at your DNS host.
#   3. Dashboard -> API Keys -> Create API Key ("Sending access" scope).
#   4. Use the settings below. SMTP_USER is literally the word "resend" -
#      that's correct, it's not a typo. SMTP_FROM_EMAIL is the address
#      visible to recipients and MUST be on the domain/subdomain you verified.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
SMTP_FROM_EMAIL=leads@leads.yourdomain.com
SMTP_FROM_NAME=AI Front Desk

# Alternative: your own mailbox's SMTP (Gmail, Microsoft 365, cPanel/GoDaddy,
# etc). Works the same way, just set SMTP_USER to the real mailbox address
# and drop SMTP_FROM_EMAIL (it falls back to SMTP_USER automatically).
# Note: Microsoft 365 plain username/password SMTP is being phased out -
# Microsoft's current timeline disables it by default for existing tenants
# at the end of December 2026.

# --- Optional ---
# Port the server listens on (Render/Railway set this automatically in production)
PORT=3000

# Comma-separated list of domains allowed to embed the widget (leave blank to allow all
# during testing, lock this down per-client once live)
ALLOWED_ORIGINS=
