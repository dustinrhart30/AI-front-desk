# --- Required ---
# Your own Anthropic API key (get one at https://console.anthropic.com)
# This is YOUR account, separate from your personal Claude.ai subscription.
# You are billed per API call - with Haiku this runs a few cents per 100 conversations.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- Required for email lead notifications ---
# Uses Resend's HTTP API (not SMTP). This matters if you're on Render or a
# similar host: most cloud platforms block outbound SMTP ports (25/465/587)
# entirely, which is invisible until you actually try to send - the HTTP API
# travels over normal HTTPS instead, so it isn't affected by that at all.
#   1. Sign up free at resend.com.
#   2. Add a domain - use a SUBDOMAIN like leads.yourdomain.com, not your
#      bare domain. This keeps it fully separate from your real mailbox's
#      existing SPF/MX records, so there's no risk of breaking real mail.
#   3. Add the SPF/DKIM records Resend shows you, at your DNS host.
#   4. Dashboard -> API Keys -> Create API Key ("Sending access" scope).
# SMTP_PASS below is that API key - the variable is named SMTP_PASS for
# historical reasons (it used to configure real SMTP), but it works
# identically as the Resend API key. SMTP_FROM_EMAIL must be an address on
# whatever domain/subdomain you verified in step 2 - it doesn't need to be
# a real inbox.
SMTP_PASS=re_your_api_key_here
SMTP_FROM_EMAIL=leads@leads.yourdomain.com
SMTP_FROM_NAME=AI Front Desk

# --- Optional ---
# Port the server listens on (Render/Railway set this automatically in production)
PORT=3000

# Comma-separated list of domains allowed to embed the widget (leave blank to allow all
# during testing, lock this down per-client once live)
ALLOWED_ORIGINS=
